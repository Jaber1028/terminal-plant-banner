# The plants themselves (out/big-*.ans) are in the repository; every other size, the themes and
# bash/build/ are made from them by build.py (or install.sh).
out/*
!out/big-*.ans
bash/build/
bash/*.tar.gz

# Reference pictures used to convert the plants
refs/

# A personal build script that rebuilds from the reference pictures
build_all.sh
saved/

# Check images and caches
__pycache__/
preview.png
check-*.png
sheet.png
banner.ans
